# Variables du front. Copiez ce fichier en `web/.env.local`, qui n'est pas
# versionné, et renseignez-le. Ne copiez pas le `.env.example` de la racine
# ici : il porte d'autres variables, dont la clé service_role, qui ne doit
# jamais approcher le navigateur.
#
# En local, `npx supabase status` affiche les deux valeurs (API_URL et
# ANON_KEY).

# URL de l'API Supabase — `API_URL` dans `npx supabase status`.
VITE_SUPABASE_URL=<http://…>

# Clé anon. Elle est publique par conception : c'est RLS qui protège, pas le
# secret de la clé. `ANON_KEY` dans `npx supabase status`.
VITE_SUPABASE_ANON_KEY=<clé anon>
