# Variables des outils qui tournent à la racine du dépôt (amorçage de
# l'administrateur). Aucune valeur réelle ici : ce fichier est versionné.
# Copiez-le en `.env`, qui n'est pas versionné, et renseignez-le.
#
# En local, `npx supabase status` affiche les trois premières valeurs
# (DB_URL, API_URL et SERVICE_ROLE_KEY). En distant, elles viennent du
# tableau de bord Supabase, section Project Settings.
#
# Les variables du front sont ailleurs : voir web/.env.example. Les deux
# fichiers ne portent pas les mêmes variables ; ne copiez pas l'un sur
# l'autre.

# Chaîne de connexion PostgreSQL — `DB_URL` dans `npx supabase status`.
DATABASE_URL=<postgresql://…>

# URL de l'API Supabase — `API_URL` dans `npx supabase status`.
SUPABASE_URL=<http://…>

# Clé service_role. Elle contourne RLS : elle ne doit jamais approcher le
# navigateur, ni être versionnée, ni être affichée dans une trace.
# `SERVICE_ROLE_KEY` dans `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=<clé service_role>

# Adresse du premier administrateur, celle que `npm run admin:bootstrap`
# invite. Personne ne peut l'inviter : c'est le point d'entrée de
# l'environnement.
BOOTSTRAP_ADMIN_EMAIL=<vous@exemple.fr>
